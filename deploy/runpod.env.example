# RunPod Pod 환경 변수 견본 (11-15) — 콘솔의 Environment Variables 에 한 줄씩 넣는다.
# 진짜 키는 이 파일에 쓰지 않는다: RunPod Secrets 에 fal_key · vlm_key 이름으로 만들고 아래처럼 가리킨다.
# 주의: 값 뒤에 주석을 붙이지 않는다 — RunPod 는 "false  # ..." 를 통째로 값으로 넣어 서버가 안 뜬다.

# 필수 키
FAL_KEY={{ RUNPOD_SECRET_fal_key }}
VLM_KEY={{ RUNPOD_SECRET_vlm_key }}

# 공개 데모 안전 설정 — /dev/* 끔, 유료 요청 하루 상한(app/core/quota.py), 프록시 뒤 사용자 IP
DEV_TOOLS=false
DEBUG=false
QUOTA_ENABLED=true
QUOTA_DAILY_USD=3
QUOTA_PER_IP_DAILY_USD=0.5
TRUST_PROXY_HEADERS=true
MAX_GENERATE_ATTEMPTS=2

# 저장 위치 — Pod 볼륨(/workspace)은 재시작해도 남고, 컨테이너 디스크는 지워진다
STORAGE_DIR=/workspace/storage
DB_PATH=/workspace/carret.db

# 볼륨 대신 S3 를 쓰려면
# STORAGE_BACKEND=s3
# S3_BUCKET=...
# AWS_ACCESS_KEY_ID={{ RUNPOD_SECRET_aws_access_key_id }}
# AWS_SECRET_ACCESS_KEY={{ RUNPOD_SECRET_aws_secret_access_key }}

# 선택: 트레이싱
# LANGFUSE_PUBLIC_KEY={{ RUNPOD_SECRET_langfuse_public_key }}
# LANGFUSE_SECRET_KEY={{ RUNPOD_SECRET_langfuse_secret_key }}
